# Copy this template to .env and fill in your own values.
# Demo runs automatically only when BOTH DATABASE_URL and GEMINI_API_KEY are absent.
DEMO_MODE=true
DATABASE_URL=
GEMINI_API_KEY=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
CRON_SECRET=
# Optional: trusted reverse proxy must overwrite user-supplied values.
TRUSTED_IP_HEADER=
